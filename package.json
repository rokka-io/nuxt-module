{
  "name": "@rokka-io/nuxt",
  "version": "1.0.2",
  "description": "Render responsive images with rokka.io in Nuxt 3",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rokka-io/nuxt-module.git"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "nuxt-module-build prepare",
    "prepack": "nuxt-module-build build && find dist/ -type f -name '*.*' | grep '.spec.' | xargs rm -f",
    "dev": "nuxi dev playground --host",
    "typecheck": "npm run typecheck:build && npm run typecheck:runtime && npm run typecheck:playground && npm run typecheck:test",
    "typecheck:build": "vue-tsc --noEmit -p .nuxt/tsconfig.node.json",
    "typecheck:runtime": "vue-tsc --noEmit -p tsconfig.runtime.json",
    "typecheck:playground": "vue-tsc --noEmit -p ./playground/tsconfig.app.json",
    "typecheck:test": "vue-tsc --noEmit -p tsconfig.test.json",
    "dev:build": "nuxi generate playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "oxlint src && eslint ./src",
    "lint:fix": "oxlint src --fix && eslint ./src --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run ",
    "test:watch": "vitest watch --disable-console-intercept --no-file-parallelism"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": [
    {
      "name": "Jan Hug",
      "url": "https://www.liip.ch/en/team/jan-hug"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "@nuxt/kit": "^4.6.3"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.3",
    "@nuxt/test-utils": "^4.3.4",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-oxlint": "^1.90.0",
    "nuxt": "^4.6.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.64.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
